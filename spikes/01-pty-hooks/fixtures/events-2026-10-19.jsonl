{"ts": 1792402467.5318139, "event": "PostToolUse", "orch_token_present": true, "orch_token_matches": true, "payload": {"session_id": "568e8a35-a919-4f8d-9925-6992b574be75", "transcript_path": "/home/user01/.claude/projects/-home-user01-DevMaestro/568e8a35-a919-4f8d-9925-6992b574be75.jsonl", "cwd": "~/DevMaestro", "scratchpad_dir": "/tmp/claude-1000/-home-user01-DevMaestro/568e8a35-a919-4f8d-9925-6992b574be75/scratchpad", "prompt_id": "ae33c396-80fd-4866-9c58-fd6d81d915ce", "permission_mode": "auto", "effort": {"level": "medium"}, "hook_event_name": "PostToolUse", "tool_name": "Bash", "tool_input": {"command": "rtk read ~/DevMaestro/spikes/01-pty-hooks/decide.py; rtk ls ~/DevMaestro/spikes/01-pty-hooks/", "description": "Show decide.py and list the spike directory"}, "tool_response": {"stdout": "\"\"\"Répond aux PermissionRequest en attente.\n\n  decide.py list\n  decide.py <allow|deny|terminal> [id]   (sans id : la seule demande en attente)\n\"\"\"\nimport json\nimport os\nimport sys\nimport time\n\nOUT = os.path.join(os.path.dirname(os.path.abspath(__file__)), \"out\")\nPENDING = os.path.join(OUT, \"pending\")\nDECISIONS = os.path.join(OUT, \"decisions\")\n\ndef pending():\n    if not os.path.isdir(PENDING):\n        return []\n    items = []\n    for name in sorted(os.listdir(PENDING)):\n        if name.endswith(\".json\"):\n            try:\n                with open(os.path.join(PENDING, name), encoding=\"utf-8\") as f:\n                    items.append(json.load(f))\n            except (OSError, ValueError):\n                pass  # fichier en cours d'écriture ou déjà supprimé\n    return items\n\ndef show(items):\n    if not items:\n        print(\"Aucune permission en attente.\")\n    for it in items:\n        p = it.get(\"payload\", {})\n        tool_input = json.dumps(p.get(\"tool_input\"), ensure_ascii=False)\n        age = int(time.time() - it.get(\"since\", time.time()))\n        print(f\"{it['id']}  {p.get('tool_name')}  ({age} s)  {tool_input[:100]}\")\n\ndef answer(decision, req_id):\n    items = pending()\n    if req_id is None:\n        if len(items) != 1:\n            show(items)\n            sys.exit(f\"Il faut préciser l'id : {len(items)} demande(s) en attente.\")\n        req_id = items[0][\"id\"]\n    elif not any(it[\"id\"] == req_id for it in items):\n        sys.exit(f\"Aucune demande en attente avec l'id {req_id}.\")\n    os.makedirs(DECISIONS, exist_ok=True)\n    path = os.path.join(DECISIONS, f\"{req_id}.json\")\n    with open(path + \".tmp\", \"w\", encoding=\"utf-8\") as f:\n        json.dump({\"decision\": decision}, f)\n    os.replace(path + \".tmp\", path)  # écriture atomique : relay ne lit jamais un fichier à moitié écrit\n    print(f\"{decision} → {req_id}\")\n\ndef main():\n    args = sys.argv[1:]\n    if args[:1] == [\"list\"]:\n        show(pending())\n    elif args and args[0] in (\"allow\", \"deny\", \"terminal\") and len(args) <= 2:\n        answer(args[0], args[1] if len(args) == 2 else None)\n    else:\n        sys.exit(__doc__)\n\nif __name__ == \"__main__\":\n    main()\nout/\nplugin/\n.gitignore  5B\nREADME.md  9.6K\ndecide.py  2.1K\ninject.py  1.5K\nmake_config.py  2.0K\nptyhost.py  5.3K\nrelay.py  4.4K\nrun.sh  4.2K\nshow.py  3.2K\nstatusline.py  2.0K\n\n10 files, 2 dirs (7 .py, 1 .gitignore, 1 .sh, 1 .md)", "stderr": "", "interrupted": false, "isImage": false, "noOutputExpected": false}, "tool_use_id": "toolu_01LjqEqLvSHiXf3r9JrJu7wo", "duration_ms": 48}}
