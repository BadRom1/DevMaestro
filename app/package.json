  "description": "Front Electron de DevMaestro : suivre et piloter des sessions Claude Code portées par le démon orchd.",
  "license": "AGPL-3.0-or-later",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
